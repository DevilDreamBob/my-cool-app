import json
import os
import random
import discord
from discord.ext import commands, tasks
from discord import app_commands

class Level(commands.Cog):
    def __init__(self, bot):
        self.bot = bot
        self.cooldown = {}
        self.data = {}
        self.file_path = "level.json"
        
        # 開機時載入資料到記憶體快取
        self.load_data()
        # 啟動每 5 分鐘自動存檔的背景任務
        self.auto_save.start()

    def load_data(self):
        """同步載入：僅在機器人啟動初始化時執行一次"""
        if not os.path.exists(self.file_path):
            with open(self.file_path, "w", encoding="utf-8") as f:
                json.dump({}, f)
        with open(self.file_path, "r", encoding="utf-8") as f:
            self.data = json.load(f)

    def save_data(self):
        """同步寫入：由背景任務或關機時觸發，不阻礙聊天監聽"""
        with open(self.file_path, "w", encoding="utf-8") as f:
            json.dump(self.data, f, indent=4, ensure_ascii=False)

    def cog_unload(self):
        """當這個 Cog 被卸載或機器人關閉時，強制存檔一次"""
        self.auto_save.cancel()
        self.save_data()
        print("💾 等級資料已安全儲存至硬碟。")

    @tasks.loop(minutes=5)
    async def auto_save(self):
        """每 5 分鐘自動將快取寫入硬碟，防止機器人非預期斷電掉資料"""
        self.save_data()

    @commands.Cog.listener()
    async def on_message(self, message):
        # 排除機器人、空訊息、非伺服器訊息
        if message.author.bot or not message.content or not message.guild:
            return

        guild_id = str(message.guild.id)
        uid = str(message.author.id)
        now = message.created_at.timestamp()
        
        # 發言冷卻檢查
        cooldown_key = f"{guild_id}_{uid}"
        if cooldown_key in self.cooldown:
            if now - self.cooldown[cooldown_key] < 60:
                return

        self.cooldown[cooldown_key] = now

        # 初始化伺服器資料結構
        if guild_id not in self.data:
            self.data[guild_id] = {
                "settings": {"notify": False},  # 👑 這裡已修正：新伺服器預設關閉通知
                "users": {}
            }
        
        # 相容舊版資料結構的防錯機制
        if "settings" not in self.data[guild_id]:
            self.data[guild_id]["settings"] = {"notify": False} # 👑 舊檔案若無此欄位，也預設關閉
        if "users" not in self.data[guild_id]:
            old_users = {k: v for k, v in self.data[guild_id].items() if k != "settings" and k != "users"}
            self.data[guild_id]["users"] = old_users
            for k in old_users.keys():
                self.data[guild_id].pop(k, None)

        users_data = self.data[guild_id]["users"]

        # 初始化使用者資料
        if uid not in users_data:
            users_data[uid] = {"xp": 0, "level": 1}

        # 隨機增加 5 到 15 經驗值
        gain = random.randint(5, 15)
        users_data[uid]["xp"] += gain

        user_stats = users_data[uid]
        need = user_stats["level"] * 100

        # 升級判定
        if user_stats["xp"] >= need:
            user_stats["xp"] -= need
            user_stats["level"] += 1
            new_level = user_stats["level"]

            # ─── 🌟 自動發放等級身分組邏輯 ───
            role_announcement = ""
            level_roles = self.data[guild_id].get("level_roles", {})
            level_key = str(new_level)
            
            if level_key in level_roles:
                role_id = level_roles[level_key]
                role = message.guild.get_role(role_id)
                if role:
                    try:
                        await message.author.add_roles(role)
                        role_announcement = f"\n🎖️ 恭喜獲得身分組：{role.name}！"
                    except discord.Forbidden:
                        print(f"❌ 無法為 {message.author.name} 增加身分組，請檢查機器人身分組權限順序是否正確。")
                    except Exception as e:
                        print(f"❌ 賦予身分組時發生錯誤: {e}")
            # ──────────────────────────────────

            # 檢查該伺服器是否有開啟升級通知（此處預設為 False，所以新群組不會發送）
            if self.data[guild_id]["settings"].get("notify", False):
                await message.channel.send(
                    f"🎉 {message.author.mention} 等級提升至 **Lv.{new_level}**！{role_announcement}"
                )

    @app_commands.command(
        name="rank",
        description="查看你在本伺服器的等級與經驗值"
    )
    async def level(self, interaction: discord.Interaction):
        if not interaction.guild_id:
            await interaction.response.send_message("❌ 請在伺服器頻道內使用此指令！", ephemeral=True)
            return

        guild_id = str(interaction.guild_id)
        uid = str(interaction.user.id)

        guild_data = self.data.get(guild_id, {})
        users_data = guild_data.get("users", {})

        if uid not in users_data:
            await interaction.response.send_message("你還沒有任何經驗值，快去聊天吧！", ephemeral=True)
            return

        user_stats = users_data[uid]
        need_xp = user_stats['level'] * 100
        
        await interaction.response.send_message(
            f"🏅 【**{interaction.user.display_name}** 在本群的等級卡片】\n"
            f"⭐ 等級：`Lv.{user_stats['level']}`\n"
            f"✨ 經驗值：`{user_stats['xp']} / {need_xp}`"
        )

    # 👑 斜線指令：開啟通知（限制管理員權限）
    @app_commands.command(
        name="notify_on",
        description="【管理員專用】開啟本伺服器的玩家升級聊天室通知"
    )
    @app_commands.checks.has_permissions(manage_guild=True)
    async def notify_on(self, interaction: discord.Interaction):
        guild_id = str(interaction.guild_id)
        
        if guild_id not in self.data:
            self.data[guild_id] = {"settings": {"notify": True}, "users": {}}
            
        self.data[guild_id]["settings"]["notify"] = True
        self.save_data() # 立刻寫入確保變更生效
        
        await interaction.response.send_message("已成功**開啟**本伺服器的等級提升通知！")

    # 👑 斜線指令：關閉通知（限制管理員權限）
    @app_commands.command(
        name="notify_off",
        description="【管理員專用】關閉本伺服器的玩家升級聊天室通知（保持默默升級）"
    )
    @app_commands.checks.has_permissions(manage_guild=True)
    async def notify_off(self, interaction: discord.Interaction):
        guild_id = str(interaction.guild_id)
        
        if guild_id not in self.data:
            self.data[guild_id] = {"settings": {"notify": False}, "users": {}}
            
        self.data[guild_id]["settings"]["notify"] = False
        self.save_data() # 立刻寫入確保變更生效
        
        await interaction.response.send_message("已成功**關閉**本伺服器的等級提升通知。")

    # 👑 斜線指令：新增等級身分組獎勵（限制管理員權限）
    @app_commands.command(
        name="levelrole_add",
        description="【管理員專用】設定達到特定等級時自動賦予的身分組"
    )
    @app_commands.checks.has_permissions(manage_guild=True)
    @app_commands.describe(level="達到多少等級（例如：5）", role="要賦予的身分組")
    async def levelrole_add(self, interaction: discord.Interaction, level: int, role: discord.Role):
        guild_id = str(interaction.guild_id)
        
        if level <= 0:
            await interaction.response.send_message("❌ 等級必須大於 0！", ephemeral=True)
            return

        # 初始化伺服器資料結構
        if guild_id not in self.data:
            self.data[guild_id] = {"settings": {"notify": False}, "users": {}}
        if "level_roles" not in self.data[guild_id]:
            self.data[guild_id]["level_roles"] = {}

        # 儲存設定（將等級轉為字串作為 JSON 鍵值）
        level_key = str(level)
        self.data[guild_id]["level_roles"][level_key] = role.id
        self.save_data() # 立刻寫入確保變更生效

        await interaction.response.send_message(f"✅ 設定成功！當成員達到 **Lv.{level}** 時，將自動賦予身分組：{role.mention}")

    # 👑 斜線指令：移除等級身分組獎勵（限制管理員權限）
    @app_commands.command(
        name="levelrole_remove",
        description="【管理員專用】刪除特定等級的身分組獎勵"
    )
    @app_commands.checks.has_permissions(manage_guild=True)
    @app_commands.describe(level="要移除哪一個等級的身分組設定（例如：5）")
    async def levelrole_remove(self, interaction: discord.Interaction, level: int):
        guild_id = str(interaction.guild_id)
        level_key = str(level)

        if guild_id not in self.data or "level_roles" not in self.data[guild_id] or level_key not in self.data[guild_id]["level_roles"]:
            await interaction.response.send_message(f"❌ 找不到 **Lv.{level}** 的身分組設定！", ephemeral=True)
            return

        # 移除設定
        role_id = self.data[guild_id]["level_roles"].pop(level_key)
        self.save_data() # 立刻寫入確保變更生效

        role = interaction.guild.get_role(role_id)
        role_name = role.mention if role else f"已刪除的身分組 (ID: {role_id})"
        await interaction.response.send_message(f"🗑️ 已成功移除 **Lv.{level}** 的身分組獎勵（原設定為：{role_name}）。")

    # 錯誤處理：若非管理員觸發指令時提示
    @notify_on.error
    @notify_off.error
    @levelrole_add.error
    @levelrole_remove.error
    async def notify_error(self, interaction: discord.Interaction, error: app_commands.AppCommandError):
        if isinstance(error, app_commands.MissingPermissions):
            await interaction.response.send_message("❌ 權限不足！此指令需要管理伺服器權限。", ephemeral=True)

async def setup(bot):
    await bot.add_cog(Level(bot))

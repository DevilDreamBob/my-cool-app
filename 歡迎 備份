    # ==================== 🙋 歡迎加入頻道控制 (Join) ====================

    @app_commands.command(name="welcome_set", description="🛠️ 設定專屬的【新成員加入】歡迎通知頻道（管理員專用）")
    @app_commands.describe(channel="請選擇要將歡迎訊息傳送到哪一個文字頻道")
    @app_commands.checks.has_permissions(manage_guild=True)
    @app_commands.guild_only()
    async def welcome_set(self, interaction: discord.Interaction, channel: discord.TextChannel):
        cfg = self.get_guild_settings(interaction.guild.id)
        cfg["join"] = channel.id 
        self.save_settings() 
        
        embed = discord.Embed(
            title="✅ 歡迎加入通知設定成功",
            description=f"已成功將【加入通知】切換至：{channel.mention}，原設定已被覆蓋並啟用。",
            color=discord.Color.green()
        )
        await interaction.response.send_message(embed=embed)

    @app_commands.command(name="welcome_cancel", description="❌ 完全取消/關閉【新成員加入】的歡迎通知")
    @app_commands.checks.has_permissions(manage_guild=True)
    @app_commands.guild_only()
    async def welcome_cancel(self, interaction: discord.Interaction):
        cfg = self.get_guild_settings(interaction.guild.id)
        cfg["join"] = False 
        self.save_settings() 
        
        embed = discord.Embed(
            title="🗑️ 歡迎加入通知已完全關閉",
            description="已完全取消此伺服器的【新成員加入】訊息。機器人將不再發送任何歡迎加入通知。",
            color=discord.Color.red()
        )
        await interaction.response.send_message(embed=embed)

    # ==================== 🛠️ 審核機制控制指令 (Review) ====================

    @app_commands.command(name="review_set", description="🛡️ 設定新成員帳號防護天數（低於此天數將自動禁言審核）")
    @app_commands.describe(days="使用者填寫的數字（天）。帳號創建少於此天數將被攔截。輸入 0 代表關閉此功能。")
    @app_commands.checks.has_permissions(manage_guild=True)
    @app_commands.guild_only()
    async def review_set(self, interaction: discord.Interaction, days: int):
        if days < 0:
            await interaction.response.send_message("❌ 天數不能小於 0 喔！", ephemeral=True)
            return
            
        cfg = self.get_guild_settings(interaction.guild.id)
        cfg["min_age_days"] = days
        self.save_settings() 
        
        if days == 0:
            embed = discord.Embed(
                title="🔓 審核隔離機制已關閉",
                description="已完全關閉新帳號防護。任何新加入的成員都將直接放行。",
                color=discord.Color.blue()
            )
        else:
            embed = discord.Embed(
                title="🛡️ 審核隔離機制設定成功",
                description=f"目前防護天數已調整為：` {days} ` 天。\n任何創帳未滿該天數的新成員將會被**自動禁言**，並發送 Embed 訊息待由版主審核。",
                color=discord.Color.green()
            )
            if days > 28:
                embed.set_footer(text="💡 提示：因 Discord 官方限制，單次 Timeout 隔離上限最多為 28 天。")

        await interaction.response.send_message(embed=embed)

    # ==================== 🚶 成員離開頻道控制 (Remove) ====================

    @app_commands.command(name="leave_set", description="🛠️ 設定專屬的【成員離開】通知頻道（管理員專用）")
    @app_commands.describe(channel="請選擇要將離開訊息傳送到哪一個文字頻道")
    @app_commands.checks.has_permissions(manage_guild=True)
    @app_commands.guild_only()
    async def leave_set(self, interaction: discord.Interaction, channel: discord.TextChannel):
        cfg = self.get_guild_settings(interaction.guild.id)
        cfg["remove"] = channel.id 
        self.save_settings() 
        
        embed = discord.Embed(
            title="✅ 成員離開通知設定成功",
            description=f"已成功將【離開通知】切換至：{channel.mention}，原設定已被覆蓋並啟用。",
            color=discord.Color.green()
        )
        await interaction.response.send_message(embed=embed)

    @app_commands.command(name="leave_cancel", description="❌ 完全取消/關閉【成員離開】的通知")
    @app_commands.checks.has_permissions(manage_guild=True)
    @app_commands.guild_only()
    async def leave_cancel(self, interaction: discord.Interaction):
        cfg = self.get_guild_settings(interaction.guild.id)
        cfg["remove"] = False 
        self.save_settings() 
        
        embed = discord.Embed(
            title="🗑️ 成員離開通知已完全關閉",
            description="已完全取消此伺服器的【成員離開】訊息。機器人將不再發送任何退出通知。",
            color=discord.Color.red()
        )
        await interaction.response.send_message(embed=embed)

    # 🛑 權限錯誤捕捉攔截器
    @review_set.error
    @welcome_set.error
    @welcome_cancel.error
    @leave_set.error
    @leave_cancel.error
    async def welcome_error_handler(self, interaction: discord.Interaction, error: app_commands.AppCommandError):
        if isinstance(error, app_commands.MissingPermissions):
            await interaction.response.send_message("❌ 權限不足！只有擁有「管理伺服器」權限的管理員才能使用此功能。", ephemeral=True)

# 👑 入口加載設定
async def setup(bot):
    await bot.add_cog(Welcome(bot))
